{
  "netlist": "../testbench/tb_read_access_time.pex.spice",
  "engine": "ngspice",
  "models": {
    "lib": "$PDK_ROOT/$PDK/libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      { "name": "ff", "sections": ["ff"] },
      { "name": "tt", "sections": ["typical"] },
      { "name": "ss", "sections": ["ss"] }
    ],
    "supply_v": { "vvdd": [2.97, 3.30, 3.63] },
    "temperature_c": [-40, 25, 125]
  },
  "analysis": { "kind": "tran", "args": "0.005n 5n uic" },
  "measurements": [
    {
      "name": "read_access_time",
      "spice": ".meas tran read_access_time trig v(wl) val=1.65 rise=1 targ par('abs(v(bl)-v(blb))') val=0.1 rise=1",
      "unit": "s"
    }
  ],
  "netlist_source": "schematic",
  "options": { "timeout_s": 60 }
}
